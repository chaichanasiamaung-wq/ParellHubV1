local ToggleButton = Instance.new("ImageButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Size = UDim2.new(0, 50, 0, 50) -- สัดส่วน 1:1
ToggleButton.Position = UDim2.new(0, 50, 0, 50)
